{
  "name": "little-life",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "test": "node --experimental-strip-types --test tests/journey.test.ts tests/expansion.test.ts tests/balance.test.ts tests/life-expansion.test.ts tests/story-rules.test.ts tests/ending-systems.test.ts",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write app components hooks lib styles tests",
    "format:check": "prettier --check app components hooks lib styles tests",
    "build:cloudflare": "node scripts/build-cloudflare.mjs",
    "deploy": "wrangler deploy",
    "deploy:check": "wrangler deploy --dry-run",
    "preview:cloudflare": "wrangler dev",
    "dev:vinext": "vite dev --port 3001",
    "build:vinext": "vite build",
    "start:vinext": "vite preview",
    "deploy:vinext": "vinext-cloudflare deploy"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "next": "^16.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "prettier": "^3.9.10",
    "typescript": "^5.9.0",
    "wrangler": "4.151.3"
  },
  "type": "module"
}
